#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" != "--show" ]]; then
    exec kitty \
        --class hypr-cheatsheet \
        --title "Keyboard Shortcuts" \
        --override background_opacity=1.0 \
        --override font_size=13.5 \
        bash "$0" --show
fi

RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
CYAN=$'\033[1;36m'
YELLOW=$'\033[1;33m'

section() {
    printf '\n%b%s%b\n' "$BOLD$CYAN" "$1" "$RESET"
}

bind() {
    printf '  %b%-30s%b %s\n' "$YELLOW" "$1" "$RESET" "$2"
}

clear
printf '%bHYPRLAND KEYBOARD SHORTCUTS%b\n' "$BOLD" "$RESET"
printf '%bSUPER = Windows key%b\n' "$DIM" "$RESET"

section "APPS"
bind "SUPER + Enter" "Terminal"
bind "SUPER + E" "Dolphin"
bind "SUPER + W" "Firefox"
bind "SUPER + ALT + W" "Chromium"
bind "SUPER + T" "Text editor"
bind "SUPER + C" "Calculator"
bind "SUPER + Space" "App launcher"
bind "SUPER + H" "This cheat sheet"

section "WINDOWS"
bind "SUPER + Q" "Close"
bind "SUPER + M" "Hide / restore window"
bind "SUPER + ALT + Space" "Float / tile"
bind "SUPER + D" "Maximize"
bind "SUPER + F" "Fullscreen"
bind "SUPER + Arrow" "Focus window"
bind "SUPER + SHIFT + Arrow" "Move window"
bind "SUPER + J" "Change split direction"
bind "ALT + Tab" "Cycle windows"
bind "SUPER + Tab" "Window switcher"
bind "SUPER + Left Mouse" "Drag window"
bind "SUPER + Right Mouse" "Resize window"

section "WORKSPACES"
bind "SUPER + Numpad 1-6" "Switch workspace"
bind "SUPER + SHIFT + Numpad 1-6" "Move window to workspace"
bind "SUPER + CTRL + Left / Right" "Previous / next workspace"
bind "SUPER + CTRL + SHIFT + ← / →" "Move window prev / next"
bind "SUPER + S" "Show / hide scratchpad"
bind "SUPER + SHIFT + S" "Send window to scratchpad"
printf '\n  %b1 DEV   2 SERVER   3 NOT_PORN   4 GAMING   5 COMFY   6 OTHER%b\n' "$DIM" "$RESET"

section "DESKTOP & TOOLS"
bind "SUPER + L" "Lock"
bind "SUPER + Z" "Noctalia settings"
bind "SUPER + X" "Control center"
bind "SUPER + V" "Clipboard history"
bind "SUPER + A" "Notifications"
bind "SUPER + P" "Color picker"
bind "SUPER + SHIFT + W" "Wallpaper picker"
bind "Print" "Region screenshot"
bind "SUPER + Print" "Full screenshot"
bind "F8" "Training screenshot"

section "COMFYUI"
bind "SUPER + SHIFT + G" "Toggle ComfyUI"
bind "SUPER + ALT + Numpad 5" "Toggle ComfyUI logs"

section "ZOOM"
bind "SUPER + - / +" "Zoom out / in"
bind "SUPER + Numpad 0 / +" "Zoom out / in"

printf '\n%bPress any key to close%b\n' "$DIM" "$RESET"
IFS= read -rsn1 _
